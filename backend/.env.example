# Neon pooled connection string for application traffic.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# Neon direct connection string for migrations and administrative scripts.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# gemini or mistral. LLM_MODEL can stay empty to use that provider's default.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# Optional: used when the provider above errors or stays silent for this many seconds.
LLM_FALLBACK_PROVIDER=mistral
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_AFTER_SECONDS=10
AGENT_MAX_TOOL_ROUNDS=5

# Optional: reuses answers to reworded knowledge-base questions, without calling the LLM.
# Needs Redis Stack for vector search. Docker Compose sets this for you.
REDIS_URL=
ANSWER_CACHE_MIN_SIMILARITY=0.90
ANSWER_CACHE_TTL_SECONDS=86400

# Password make seed gives the demo logins. Leave empty to skip creating them.
DEMO_PASSWORD=tea-and-lotus-demo
NEON_AUTH_BASE_URL=https://example.neonauth.example/db/auth
NEON_AUTH_JWKS_URL=https://example.neonauth.example/.well-known/jwks.json

